@model Soransoft.Web.Areas.Partner.Controllers.ForgotPasswordViewModel
@{
    ViewData["Title"] = "فراموشی رمز عبور";
    Layout = "/Views/Shared/_Layout.cshtml";
}
<div class="sn-portal-login-wrap">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-12 col-md-6 col-lg-4">
                <div class="text-center mb-4">
                    <a href="/" class="sn-logo">SORANSOFT</a>
                    <h1 class="sn-portal-title mt-3"><i class="bi bi-key me-2"></i>فراموشی رمز عبور</h1>
                    <p class="sn-portal-sub">درخواست بازنشانی برای مدیر ارسال می‌شود</p>
                </div>

                <div class="sn-portal-card">
                    @if (TempData["Success"] is string ok)
                    {
                        <div class="alert alert-success py-2">@ok</div>
                    }
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <form asp-area="Partner" asp-controller="Account" asp-action="ForgotPassword" method="post">
                        <div class="mb-3">
                            <label class="form-label">نام کاربری</label>
                            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        </div>
                        <div class="mb-4">
                            <label class="form-label">پیام به مدیر (اختیاری)</label>
                            <textarea asp-for="Message" class="form-control" rows="3" maxlength="500"
                                      placeholder="مثلاً شماره تماس یا توضیح کوتاه برای مدیر"></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn sn-btn-portal-lg w-100">
                            <i class="bi bi-send me-2"></i>ارسال درخواست بازنشانی
                        </button>
                    </form>
                </div>

                <p class="text-center small sn-portal-hint mt-4">
                    <i class="bi bi-shield-check me-1"></i>
                    رمز جدید فقط توسط مدیر بازنشانی می‌شود؛ نتیجه درخواست از طریق مدیر به شما اعلام خواهد شد.
                </p>
                <p class="text-center mt-3">
                    <a asp-area="Partner" asp-controller="Account" asp-action="Login" class="sn-portal-back">
                        <i class="bi bi-arrow-right me-1"></i>بازگشت به صفحه ورود
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
