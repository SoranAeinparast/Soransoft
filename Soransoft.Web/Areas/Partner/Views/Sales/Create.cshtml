@model Soransoft.Web.Areas.Partner.Controllers.LeadInputModel
@{
    ViewData["Title"] = "ثبت لید جدید";
}
<h5 class="mb-3"><i class="bi bi-person-plus me-2"></i>ثبت مشتری احتمالی</h5>

<div class="sn-admin-card" style="max-width:640px">
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label">نام مشتری *</label>
                <input asp-for="CustomerName" class="form-control" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">شماره موبایل مشتری *</label>
                <input asp-for="CustomerMobile" class="form-control" dir="ltr" placeholder="09xxxxxxxxx" />
            </div>
            <div class="col-12">
                <label class="form-label">نیاز / شرح درخواست *</label>
                <textarea asp-for="Requirement" class="form-control" rows="4" placeholder="مثلاً: سایت فروشگاهی شیرینی با درگاه پرداخت..."></textarea>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label">مبلغ تخمینی فروش (تومان)</label>
                <input asp-for="EstimatedAmount" type="number" class="form-control" min="0" step="1000000" />
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>ثبت لید</button>
            <a href="/Partner/Sales" class="btn btn-outline-secondary">انصراف</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
