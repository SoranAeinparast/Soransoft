@model List<Soransoft.Domain.Entities.Lead>
@{
    ViewData["Title"] = "لیدهای من";
    string StageBadge(Soransoft.Domain.Entities.LeadStage s) => s switch
    {
        Soransoft.Domain.Entities.LeadStage.New => "bg-info text-dark",
        Soransoft.Domain.Entities.LeadStage.Negotiating => "bg-warning text-dark",
        Soransoft.Domain.Entities.LeadStage.Contracted => "bg-success",
        _ => "bg-secondary"
    };
    string StageTitle(Soransoft.Domain.Entities.LeadStage s) => s switch
    {
        Soransoft.Domain.Entities.LeadStage.New => "جدید",
        Soransoft.Domain.Entities.LeadStage.Negotiating => "در حال مذاکره",
        Soransoft.Domain.Entities.LeadStage.Contracted => "قرارداد بسته شده",
        _ => "منصرف شده"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-funnel me-2"></i>لیدها (@Model.Count)</h5>
    <a href="/Partner/Sales/Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>ثبت لید جدید</a>
</div>

<div class="sn-admin-card">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">هنوز لیدی ثبت نکرده‌اید. مشتری احتمالی بعدی‌تان را ثبت کنید.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>مشتری</th>
                        <th>نیاز</th>
                        <th>مبلغ تخمینی</th>
                        <th>وضعیت</th>
                        <th>تاریخ ثبت</th>
                        <th class="text-end">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td>
                                <strong>@l.CustomerName</strong>
                                <div class="small text-muted" dir="ltr">@l.CustomerMobile</div>
                            </td>
                            <td class="small" style="max-width:260px">@l.Requirement</td>
                            <td>@(l.EstimatedAmount?.ToString("N0") ?? "—")</td>
                            <td><span class="badge @StageBadge(l.Stage)">@StageTitle(l.Stage)</span></td>
                            <td class="small">@PersianDisplay.Date(l.CreatedAt)</td>
                            <td class="text-end">
                                @if (l.Stage != Soransoft.Domain.Entities.LeadStage.Contracted && l.Stage != Soransoft.Domain.Entities.LeadStage.Lost)
                                {
                                    <form asp-action="ChangeStage" method="post" class="d-inline-flex gap-1 align-items-center">
                                        <input type="hidden" name="id" value="@l.Id" />
                                        <input type="hidden" name="note" value="" />
                                        <select name="stage" class="form-select form-select-sm" style="width:auto" title="تغییر وضعیت لید">
                                            <option value="2">در حال مذاکره</option>
                                            <option value="4">منصرف شده</option>
                                        </select>
                                        <button class="btn btn-sm btn-outline-primary" title="تغییر وضعیت"><i class="bi bi-arrow-repeat"></i></button>
                                    </form>
                                }
                                @if (l.Stage == Soransoft.Domain.Entities.LeadStage.Contracted)
                                {
                                    <span class="small text-success"><i class="bi bi-check2"></i> تبدیل به قرارداد</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="alert alert-info small mt-3">
    <i class="bi bi-info-circle me-1"></i>
    تبدیل لید به قرارداد و تعیین پورسانت توسط مدیر انجام می‌شود؛ شما وضعیت مذاکره را به‌روز نگه دارید.
</div>
