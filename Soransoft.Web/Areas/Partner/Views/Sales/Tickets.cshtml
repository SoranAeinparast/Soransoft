@model List<Soransoft.Domain.Entities.SupportTicket>
@{
    ViewData["Title"] = "درخواست بررسی فنی";
    var myContracts = ViewBag.MyContracts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    string StatusBadge(Soransoft.Domain.Entities.TicketStatus s) => s switch
    {
        Soransoft.Domain.Entities.TicketStatus.New => "bg-info text-dark",
        Soransoft.Domain.Entities.TicketStatus.InProgress => "bg-warning text-dark",
        Soransoft.Domain.Entities.TicketStatus.Answered => "bg-success",
        _ => "bg-secondary"
    };
    string StatusTitle(Soransoft.Domain.Entities.TicketStatus s) => s switch
    {
        Soransoft.Domain.Entities.TicketStatus.New => "جدید",
        Soransoft.Domain.Entities.TicketStatus.InProgress => "در حال بررسی",
        Soransoft.Domain.Entities.TicketStatus.Answered => "پاسخ داده شد",
        _ => "بسته شده"
    };
}

<div class="row g-3">
    <div class="col-12 col-lg-5">
        <div class="sn-admin-card">
            <h6 class="mb-3"><i class="bi bi-plus-circle me-2"></i>ثبت درخواست بررسی فنی</h6>
            @if (!myContracts.Any())
            {
                <p class="small text-muted mb-0">ابتدا باید قراردادی برای شما ثبت شده باشد.</p>
            }
            else
            {
                <form asp-action="CreateTicket" method="post">
                    <div class="mb-3">
                        <label class="form-label small">قرارداد / محصول</label>
                        <select name="ContractId" class="form-select" required>
                            @foreach (var c in myContracts)
                            {
                                <option value="@c.Id">@c.Title</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">موضوع</label>
                        <input name="Subject" class="form-control" required maxlength="200" placeholder="مثلاً: خطای درگاه پیامک مشتری" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">شرح درخواست</label>
                        <textarea name="Description" class="form-control" rows="4" required placeholder="مشکل فنی مشاهده‌شده در جلسه با مشتری را شرح دهید..."></textarea>
                    </div>
                    <button class="btn btn-primary w-100"><i class="bi bi-send me-1"></i>ارسال به تیم فنی</button>
                </form>
            }
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="sn-admin-card">
            <h6 class="mb-3"><i class="bi bi-list-task me-2"></i>درخواست‌های من (@Model.Count)</h6>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">درخواستی ثبت نشده است.</p>
            }
            @foreach (var t in Model)
            {
                <div class="border rounded-3 p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <strong>@t.Subject</strong>
                        <span class="badge @StatusBadge(t.Status)">@StatusTitle(t.Status)</span>
                    </div>
                    <div class="small text-muted mt-1">@t.Contract.Title</div>
                    <p class="small mb-1 mt-2">@t.Description</p>
                    @if (!string.IsNullOrWhiteSpace(t.Response))
                    {
                        <div class="bg-light rounded-3 p-2 small border">
                            <strong class="text-success"><i class="bi bi-reply me-1"></i>پاسخ تیم فنی:</strong>
                            @t.Response
                        </div>
                    }
                    <div class="small text-muted mt-1">@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                </div>
            }
        </div>
    </div>
</div>
