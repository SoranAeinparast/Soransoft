@model List<SiteSetting>
@{
    ViewData["Title"] = "تنظیمات سایت";
    var groups = Model.GroupBy(s => s.Group).ToList();
    // ایندکس باید به‌ازای هر تنظیم یکتا باشد، نه هر گروه؛ وگرنه مدل‌بایندر همه موارد هم‌نام را فقط یک‌بار می‌پذیرد
    var settingIndex = 0;
}
<h5 class="mb-4">تنظیمات سایت</h5>

<div class="d-flex justify-content-end mb-3">
    <button class="btn sn-btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newSettingForm" aria-expanded="false">
        <i class="bi bi-plus-lg me-1"></i> تنظیم جدید
    </button>
</div>
<div class="collapse mb-4" id="newSettingForm">
    <div class="sn-admin-card">
        <h6 class="fw-bold mb-3">افزودن تنظیم جدید</h6>
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">کلید (انگلیسی)</label>
                <input name="key" class="form-control" dir="ltr" placeholder="SupportEmail" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">عنوان نمایشی</label>
                <input name="title" class="form-control" placeholder="ایمیل پشتیبانی" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">مقدار اولیه</label>
                <input name="value" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label">فایل تصویر</label>
                <input name="imageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
            </div>
            <div class="col-md-2">
                <label class="form-label">گروه</label>
                <input name="group" class="form-control" list="settingGroups" placeholder="General" />
                <datalist id="settingGroups">
                    @foreach (var g in groups) { <option value="@g.Key"></option> }
                </datalist>
            </div>
            <div class="col-md-1">
                <label class="form-label">نوع</label>
                <select name="type" class="form-select">
                    <option value="text">متن</option>
                    <option value="textarea">متن بلند</option>
                    <option value="image">تصویر</option>
                    <option value="boolean">روشن/خاموش</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn sn-btn-primary w-100">افزودن</button>
            </div>
        </form>
    </div>
</div>

<form asp-action="Save" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @for (int g = 0; g < groups.Count; g++)
    {
        var group = groups[g];
        <div class="sn-admin-card mb-4">
            <h6 class="fw-bold mb-3">@group.Key</h6>
            @foreach (var setting in group)
            {
                var i = settingIndex++;
                <input type="hidden" name="settings[@i].Key" value="" />
                <input type="hidden" name="settings.Index" value="@i" />
                <div class="row align-items-center mb-2">
                    <label class="col-12 col-md-4 col-form-label">@setting.Title <small class="text-muted" dir="ltr">(@setting.Key)</small></label>
                    <div class="col-12 col-md-8">
                        <input type="hidden" name="settings[@i].Id" value="@setting.Id" />
                        @if (setting.Type == "textarea")
                        {
                            <textarea name="settings[@i].Value" class="form-control" rows="2">@setting.Value</textarea>
                        }
                        else if (setting.Type == "boolean")
                        {
                            <div class="form-check form-switch">
                                <input type="checkbox" name="settings[@i].Value" value="true" class="form-check-input" @(bool.TryParse(setting.Value, out var enabled) && enabled ? "checked" : null) />
                                <label class="form-check-label">فعال</label>
                            </div>
                            <input type="hidden" name="settings[@i].Value" value="false" />
                        }
                        else if (setting.Type == "image")
                        {
                            <input name="settings[@i].Value" value="@setting.Value" class="form-control mb-2" dir="ltr" />
                            <input name="settingFile_@setting.Id" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" />
                            @if (!string.IsNullOrWhiteSpace(setting.Value))
                            {
                                <img src="~/@setting.Value.TrimStart('~', '/')" alt="@setting.Title" class="mt-2 rounded" style="max-width:180px;max-height:80px;object-fit:contain" />
                            }
                        }
                        else
                        {
                            <input name="settings[@i].Value" value="@setting.Value" class="form-control" />
                        }
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col-12 text-end">
                        <button type="submit" form="delete-setting-@setting.Id" class="btn btn-sm btn-link text-danger p-0"
                                onclick="return confirm('این تنظیم برای همیشه حذف شود؟')">حذف تنظیم</button>
                    </div>
                </div>
            }
        </div>
    }
    <button type="submit" class="btn sn-btn-primary px-5">ذخیره تنظیمات</button>
</form>

@foreach (var setting in Model)
{
    <form id="delete-setting-@setting.Id" method="post" action="/Admin/SiteSettings/Delete/@setting.Id">
        @Html.AntiForgeryToken()
    </form>
}
