@model ContactMessage
@{
    ViewData["Title"] = "جزئیات پیام";
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">پیام #@Model.Id — @Model.Subject</h6>
            <dl class="row">
                <dt class="col-3">نام</dt><dd class="col-9">@Model.FullName</dd>
                <dt class="col-3">موبایل</dt><dd class="col-9" dir="ltr">@Model.Mobile</dd>
                <dt class="col-3">ایمیل</dt><dd class="col-9" dir="ltr">@(Model.Email ?? "—")</dd>
                <dt class="col-3">تاریخ</dt><dd class="col-9">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                <dt class="col-3">IP</dt><dd class="col-9" dir="ltr">@(Model.IpAddress ?? "—")</dd>
            </dl>
            <hr />
            <p class="mb-0" style="line-height:2">@Model.Message</p>
        </div>
    </div>
</div>
<div class="mt-3 text-center">
    <a href="/Admin/ContactMessages" class="btn btn-outline-secondary">بازگشت</a>
</div>
