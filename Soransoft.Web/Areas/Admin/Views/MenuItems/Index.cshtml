@model List<MenuItem>
@{
    ViewData["Title"] = "مدیریت منوها";
}
<h5 class="mb-4">مدیریت منوها</h5>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">افزودن آیتم</h6>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label">عنوان</label>
                    <input name="Title" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">آدرس (URL)</label>
                    <input name="Url" class="form-control" dir="ltr" list="site-page-links" required />
                    <small class="text-muted">صفحات منتشرشده در پیشنهادها قرار دارند.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">موقعیت</label>
                    <select name="Position" class="form-select" asp-items="Html.GetEnumSelectList<MenuPosition>()"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">ترتیب</label>
                    <input name="DisplayOrder" class="form-control" type="number" value="1" />
                </div>
                <button type="submit" class="btn sn-btn-primary w-100">افزودن</button>
            </form>
        </div>
    </div>
    <datalist id="site-page-links">
        @if (ViewBag.Pages is List<SitePage> pages)
        {
            @foreach (var page in pages)
            {
                <option value="/Page/@Uri.EscapeDataString(page.Slug)">@(page.Title)</option>
            }
        }
    </datalist>
    <div class="col-12 col-lg-8">
        <div class="sn-admin-card">
            <div class="table-responsive">
                <table class="table sn-admin-table align-middle">
                    <thead>
                        <tr><th>#</th><th>عنوان</th><th>آدرس</th><th>موقعیت</th><th>ترتیب</th><th>فعال</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td colspan="4">
                                    <form asp-action="Edit" method="post" class="row g-1 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@item.Id" />
                                        <input type="hidden" name="IsActive" value="@item.IsActive" />
                                        <div class="col-4"><input name="Title" value="@item.Title" class="form-control form-control-sm" /></div>
                                        <div class="col-4"><input name="Url" value="@item.Url" class="form-control form-control-sm" dir="ltr" list="site-page-links" /></div>
                                        <div class="col-2">
                                            <select name="Position" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<MenuPosition>()"></select>
                                        </div>
                                        <div class="col-1"><input name="DisplayOrder" value="@item.DisplayOrder" class="form-control form-control-sm" type="number" /></div>
                                        <div class="col-1"><button type="submit" class="btn btn-sm btn-outline-primary w-100">ثبت</button></div>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <form method="post" action="/Admin/MenuItems/Toggle/@item.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-success" : "btn-outline-secondary")">
                                            @(item.IsActive ? "فعال" : "غیرفعال")
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post" action="/Admin/MenuItems/Delete/@item.Id" data-swal-confirm="حذف شود؟">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
