@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.EntityFrameworkCore
@using Soransoft.Infrastructure.Persistence
@using Soransoft.Domain.Entities
@inject IAntiforgery Antiforgery
@inject SoransoftDbContext Db
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userName = User.Identity?.Name ?? "Admin";
    var afToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var pendingResetCount = await Db.PasswordResetRequests.AsNoTracking()
        .CountAsync(r => r.Status == PasswordResetStatus.Pending);
    // فقط صفحاتی که ویرایشگر متنی دارند، اسکریپت TinyMCE را بارگذاری می‌کنند
    var loadTinyMce = ViewData["LoadRichEditor"] as bool? == true;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | پنل مدیریت" : "پنل مدیریت سوران سافت")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/tinymce/skins/ui/oxide/skin.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @* توکن ضد جعل درخواست برای آپلود تصویر ویرایشگر *@
    <meta name="csrf-token" content="@afToken" />
</head>
<body class="sn-admin">
    <div class="sn-admin-wrapper">
        <aside class="sn-admin-sidebar">
            <div class="sn-admin-brand">
                <span class="sn-logo">SORANSOFT</span>
                <small>پنل مدیریت</small>
            </div>
            <nav class="sn-admin-nav">
                <a href="/Admin/Dashboard" class="@(controller == "Dashboard" ? "active" : "")"><i class="bi bi-speedometer2"></i> داشبورد</a>

                <div class="sn-admin-nav-group">مدیریت محتوا</div>
                <a href="/Admin/Sliders" class="@(controller == "Sliders" ? "active" : "")"><i class="bi bi-images"></i> اسلایدر صفحه اصلی</a>
                <a href="/Admin/Services" class="@(controller == "Services" ? "active" : "")"><i class="bi bi-gear"></i> سرویس‌ها</a>
                <a href="/Admin/Portfolios" class="@(controller == "Portfolios" ? "active" : "")"><i class="bi bi-collection"></i> نمونه‌کارها</a>
                <a href="/Admin/Articles" class="@(controller == "Articles" ? "active" : "")"><i class="bi bi-journal-text"></i> مقالات</a>
                <a href="/Admin/ArticleCategories" class="@(controller == "ArticleCategories" ? "active" : "")"><i class="bi bi-tags"></i> دسته‌بندی مقالات</a>
                <a href="/Admin/Tariffs" class="@(controller == "Tariffs" ? "active" : "")"><i class="bi bi-cash-coin"></i> تعرفه‌ها</a>
                <a href="/Admin/TeamMembers" class="@(controller == "TeamMembers" ? "active" : "")"><i class="bi bi-people"></i> اعضای تیم</a>
                <a href="/Admin/MediaLibrary" class="@(controller == "MediaLibrary" ? "active" : "")"><i class="bi bi-folder2-open"></i> کتابخانه رسانه</a>
                <a href="/Admin/MediaLibrary/Storage" class="@(action == "Storage" ? "active" : "")"><i class="bi bi-pie-chart"></i> مصرف فضا</a>

                <div class="sn-admin-nav-group">صندوق ورودی</div>
                <a href="/Admin/ProjectOrders" class="@(controller == "ProjectOrders" ? "active" : "")"><i class="bi bi-bag-check"></i> سفارش‌های پروژه</a>
                <a href="/Admin/SiteUsers" class="@(controller == "SiteUsers" ? "active" : "")"><i class="bi bi-person-badge"></i> کاربران سایت</a>
                <a href="/Admin/ContactMessages" class="@(controller == "ContactMessages" ? "active" : "")"><i class="bi bi-envelope"></i> پیام‌های تماس</a>
                <a href="/Admin/ConsultationRequests" class="@(controller == "ConsultationRequests" ? "active" : "")"><i class="bi bi-chat-dots"></i> درخواست‌های مشاوره</a>

                <div class="sn-admin-nav-group">پرتال همکاران</div>
                <a href="/Admin/PortalPartners" class="@(controller == "PortalPartners" ? "active" : "")"><i class="bi bi-briefcase"></i> همکاران پرتال</a>
                <a href="/Admin/PortalLeads" class="@(controller == "PortalLeads" ? "active" : "")"><i class="bi bi-funnel"></i> لیدهای همکاران</a>
                <a href="/Admin/PortalLeads/Contracts" class="@(controller == "PortalLeads" && (action == "Contracts" || action == "Manage") ? "active" : "")"><i class="bi bi-file-earmark-text"></i> قراردادها و پورسانت</a>
                <a href="/Admin/PortalDev" class="@(controller == "PortalDev" ? "active" : "")"><i class="bi bi-kanban"></i> برد تسک‌های فنی</a>
                 <a href="/Admin/PortalDev/Projects" class="@(controller == "PortalDev" && action == "Projects" ? "active" : "")"><i class="bi bi-diagram-3"></i> پروژه‌های فنی</a>
                 <a href="/Admin/PortalProjects" class="@(controller == "PortalProjects" ? "active" : "")"><i class="bi bi-briefcase"></i> پروژه‌های آماده ارائه به مشتری</a>
                 <a href="/Admin/PortalDev/Workload" class="@(controller == "PortalDev" && action == "Workload" ? "active" : "")"><i class="bi bi-speedometer"></i> بار کاری تیم</a>
                <a href="/Admin/PortalDev/Tickets" class="@(controller == "PortalDev" && action == "Tickets" ? "active" : "")"><i class="bi bi-life-preserver"></i> درخواست‌های فنی</a>
                <a href="/Admin/PortalAnnouncements" class="@(controller == "PortalAnnouncements" ? "active" : "")"><i class="bi bi-megaphone"></i> مرکز ارتباطی</a>
                <a href="/Admin/PortalAgreements" class="@(controller == "PortalAgreements" ? "active" : "")"><i class="bi bi-journal-bookmark"></i> قراردادهای همکاری</a>
                <a href="/Admin/PortalCosts" class="@(controller == "PortalCosts" ? "active" : "")"><i class="bi bi-receipt-cutoff"></i> هزینه‌های شخص ثالث</a>
                <a href="/Admin/PortalWallet" class="@(controller == "PortalWallet" ? "active" : "")"><i class="bi bi-wallet2"></i> کیف پول همکاران</a>
                <a href="/Admin/PortalPartners/ResetRequests" class="@(controller == "PortalPartners" && action == "ResetRequests" ? "active" : "")">
                    <i class="bi bi-inbox"></i> درخواست‌های رمز
                    @if (pendingResetCount > 0)
                    {
                        <span class="badge rounded-pill bg-danger ms-1">@pendingResetCount</span>
                    }
                </a>

                <div class="sn-admin-nav-group">سیستم</div>
                <a href="/Admin/MenuItems" class="@(controller == "MenuItems" ? "active" : "")"><i class="bi bi-list"></i> منوها</a>
                <a href="/Admin/Account/ChangePassword" class="@(action == "ChangePassword" ? "active" : "")"><i class="bi bi-key"></i> تغییر رمز عبور</a>
                <a href="/Admin/SiteSettings" class="@(controller == "SiteSettings" ? "active" : "")"><i class="bi bi-sliders"></i> تنظیمات سایت</a>
                <a href="/Admin/ErrorLogs" class="@(controller == "ErrorLogs" ? "active" : "")"><i class="bi bi-bug"></i> لاگ خطاها</a>
                <a href="/" target="_blank"><i class="bi bi-box-arrow-up-left"></i> مشاهده سایت</a>
                <form method="post" action="/Admin/Account/Logout" class="sn-admin-logout-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sn-admin-nav-button"><i class="bi bi-box-arrow-right"></i> خروج (@userName)</button>
                </form>
            </nav>
        </aside>

        <main class="sn-admin-main">
            <header class="sn-admin-topbar">
                <button class="sn-admin-burger d-lg-none" type="button" id="adminBurger"><i class="bi bi-list"></i></button>
                <h1 class="sn-admin-page-title">@ViewData["Title"]</h1>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <a href="/Admin/Dashboard" class="btn btn-sm btn-outline-secondary d-none d-md-inline-flex"><i class="bi bi-house me-1"></i>داشبورد</a>
                    <span class="badge sn-badge-admin">ادمین</span>
                </div>
            </header>
            <div class="sn-admin-content">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success">@success</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger">@error</div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/persian-ui.js" asp-append-version="true"></script>
    @if (loadTinyMce)
    {
        <script src="~/lib/tinymce/tinymce.min.js" asp-append-version="true"></script>
        @* مودال انتخاب تصویر از کتابخانه رسانه داخل TinyMCE *@
        <div class="modal fade" id="snMediaPickerModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header py-2">
                        <h6 class="modal-title"><i class="bi bi-images me-2"></i>انتخاب تصویر از کتابخانه رسانه</h6>
                        <div class="ms-auto d-flex align-items-center gap-2">
                            <label class="btn btn-sm btn-outline-primary mb-0">
                                <i class="bi bi-upload me-1"></i> آپلود جدید
                                <input type="file" id="snMediaPickerUpload" accept=".jpg,.jpeg,.png,.gif,.webp,.svg" hidden />
                            </label>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <small class="text-danger d-block mb-2" id="snMediaPickerStatus"></small>
                        <div class="sn-media-modal-grid" id="snMediaPickerGrid"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
