@model PromoBanner
@using Soransoft.Domain.Enums
<div class="row g-3">
    <div class="col-12 col-md-6">
        <label asp-for="Title" class="form-label">عنوان</label>
        <input asp-for="Title" class="form-control" required />
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Badge" class="form-label">برچسب کوتاه (اختیاری)</label>
        <input asp-for="Badge" class="form-control" />
    </div>
    <div class="col-12">
        <label asp-for="Text" class="form-label">متن</label>
        <textarea asp-for="Text" class="form-control" rows="3"></textarea>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="ButtonText" class="form-label">متن دکمه (اختیاری)</label>
        <input asp-for="ButtonText" class="form-control" placeholder="بیشتر بدانید" />
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Link" class="form-label">لینک (اختیاری)</label>
        <input asp-for="Link" class="form-control" dir="ltr" placeholder="/ContactUs یا https://..." />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">نوع بنر</label>
        <select asp-for="Type" class="form-select">
            <option value="1">متن اسکرولی</option>
            <option value="2">کارت ویژه</option>
            <option value="3">بنر ثابت تبلیغاتی</option>
        </select>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="ScrollDirection" class="form-label">جهت حرکت متن اسکرولی</label>
        <select asp-for="ScrollDirection" class="form-select">
            <option value="@((int)PromoBannerScrollDirection.RightToLeft)">راست به چپ</option>
            <option value="@((int)PromoBannerScrollDirection.LeftToRight)">چپ به راست</option>
        </select>
        <small class="text-muted">این گزینه فقط برای نوع «متن اسکرولی» اعمال می‌شود.</small>
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label">محل نمایش</label>
        <select asp-for="Placement" class="form-select">
            <option value="1">همه صفحات</option>
            <option value="2">پس از هیرو صفحه اصلی</option>
            <option value="3">پیش از فوتر صفحه اصلی</option>
        </select>
    </div>
    <div class="col-12">
        <label class="form-label">تصویر (اختیاری)</label>
        <partial name="_MediaImagePicker" model="Model.Image" view-data="@(new ViewDataDictionary(ViewData) { ["MediaInputName"] = "Image", ["MediaInputId"] = "promo-image-input", ["MediaPreviewId"] = "promo-image-preview" })" />
    </div>
    <div class="col-6 col-md-3">
        <label asp-for="DisplayOrder" class="form-label">ترتیب نمایش</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" min="0" />
    </div>
    <div class="col-6 col-md-3 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">فعال</label>
        </div>
    </div>
    <div class="col-12 col-md-6 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="OpenInNewTab" class="form-check-input" />
            <label asp-for="OpenInNewTab" class="form-check-label">باز شدن لینک در تب جدید</label>
        </div>
    </div>
</div>
