@model List<Article>
@{
    ViewData["Title"] = "مدیریت مقالات";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">مقالات</h5>
    <a href="/Admin/Articles/Create" class="btn sn-btn-primary"><i class="bi bi-plus-lg me-1"></i> مقاله جدید</a>
</div>

<div class="sn-admin-card">
    <div class="table-responsive">
        <table class="table sn-admin-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان</th>
                    <th>دسته</th>
                    <th>نویسنده</th>
                    <th>وضعیت</th>
                    <th>بازدید</th>
                    <th>تاریخ انتشار</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.ArticleCategory?.Title</td>
                        <td>@item.AuthorName</td>
                        <td>
                            <span class="badge @(item.Status == PublishStatus.Published ? "bg-success" : item.Status == PublishStatus.Draft ? "bg-secondary" : "bg-warning")">
                                @item.Status.ToString()
                            </span>
                        </td>
                        <td>@item.VisitCount</td>
                        <td class="small">@PersianDisplay.Date(item.PublishedAt)</td>
                        <td class="text-nowrap">
                            <a href="/Admin/Articles/Edit/@item.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                            <form method="post" action="/Admin/Articles/Delete/@item.Id" class="d-inline"
                                  data-swal-confirm="حذف شود؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
