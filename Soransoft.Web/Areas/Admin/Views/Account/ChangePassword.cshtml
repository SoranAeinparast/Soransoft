@model Soransoft.Web.Areas.Admin.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}
<h5 class="mb-4">تغییر رمز عبور</h5>

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="sn-admin-card">
            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn sn-btn-primary w-100">ذخیره رمز جدید</button>
            </form>
        </div>
        <div class="alert alert-warning small">
            <i class="bi bi-shield-exclamation me-1"></i>
            رمز پیش‌فرض اولیه (<code dir="ltr">Admin@@123</code>) در کد منبع Seeder ثبت شده و ناامن است؛ بعد از اولین ورود حتماً همین‌جا عوضش کنید.
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
