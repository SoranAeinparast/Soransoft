@model SiteUser
@{
    ViewData["Title"] = "جزئیات کاربر";
}
<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">اطلاعات کاربر #@Model.Id</h6>
            <dl class="row mb-0">
                <dt class="col-4">نام</dt><dd class="col-8">@Model.FullName</dd>
                <dt class="col-4">موبایل</dt><dd class="col-8" dir="ltr">@Model.Mobile</dd>
                <dt class="col-4">ایمیل</dt><dd class="col-8" dir="ltr">@Model.Email</dd>
                <dt class="col-4">تاریخ عضویت</dt><dd class="col-8">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                <dt class="col-4">آخرین ورود</dt><dd class="col-8">@(Model.LastLoginAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</dd>
                <dt class="col-4">وضعیت</dt>
                <dd class="col-8">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "فعال" : "غیرفعال")</span>
                </dd>
            </dl>
        </div>
        <div class="mt-3">
            <a href="/Admin/SiteUsers" class="btn btn-outline-secondary">بازگشت به لیست</a>
        </div>
    </div>
    <div class="col-12 col-lg-7">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">سفارش‌های این کاربر (@Model.ProjectOrders.Count)</h6>
            @if (!Model.ProjectOrders.Any())
            {
                <p class="text-muted small mb-0">این کاربر هنوز سفارشی ثبت نکرده است.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table sn-admin-table align-middle">
                        <thead><tr><th>#</th><th>نوع پروژه</th><th>بودجه</th><th>وضعیت</th><th>تاریخ</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var o in Model.ProjectOrders.OrderByDescending(x => x.CreatedAt))
                            {
                                <tr>
                                    <td>@o.Id</td>
                                    <td>@o.ProjectType.ToString()</td>
                                    <td>@(o.Budget?.ToString("N0") ?? "—")</td>
                                    <td><span class="badge @(o.Status == ProjectOrderStatus.New ? "bg-primary" : o.Status == ProjectOrderStatus.Delivered ? "bg-success" : o.Status == ProjectOrderStatus.Cancelled ? "bg-danger" : "bg-secondary")">@o.Status.ToString()</span></td>
                                    <td class="small">@o.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td><a href="/Admin/ProjectOrders/Details/@o.Id" class="btn btn-sm btn-outline-primary">مشاهده</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
