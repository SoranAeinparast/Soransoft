@model SitePage
@{
    ViewData["Title"] = "صفحه جدید";
    ViewData["LoadRichEditor"] = true;
}
<h5 class="mb-4">صفحه محتوایی جدید</h5>
<div class="sn-admin-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <partial name="FormFields" model="Model" />
        <button type="submit" class="btn sn-btn-primary">ذخیره</button>
        <a href="/Admin/Pages" class="btn btn-outline-secondary">انصراف</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
