@{
    ViewData["Title"] = "کیف پول همکاران";
    var rows = ViewBag.Rows as List<(Soransoft.Domain.Entities.Partner Partner, decimal Balance, decimal Locked)>;
    var pending = ViewBag.PendingRequests as List<Soransoft.Domain.Entities.WithdrawalRequest>;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4">
        <div class="sn-stat-card sn-stat-success"><i class="bi bi-wallet2"></i>
            <div><span class="sn-stat-value">@rows?.Sum(r => r.Balance).ToString("N0")</span><span class="sn-stat-label">مجموع بدهی به همکاران (تومان)</span></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="sn-stat-card sn-stat-warning"><i class="bi bi-hourglass-split"></i>
            <div><span class="sn-stat-value">@rows?.Sum(r => r.Locked).ToString("N0")</span><span class="sn-stat-label">در صف برداشت (قفل‌شده)</span></div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="sn-stat-card sn-stat-info"><i class="bi bi-inbox"></i>
            <div><span class="sn-stat-value">@pending?.Count</span><span class="sn-stat-label">درخواست در انتظار تایید</span></div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12 col-xl-5">
        <div class="sn-admin-card mb-3">
            <h6 class="mb-3"><i class="bi bi-plus-circle me-2"></i>واریز سهم همکار</h6>
            <form asp-action="Deposit" method="post" enctype="multipart/form-data">
                <div class="mb-2">
                    <label class="form-label small">همکار *</label>
                    <select name="PartnerId" class="form-select form-select-sm" required>
                        <option value="">— انتخاب —</option>
                        @foreach (var r in rows!)
                        {
                            <option value="@r.Partner.Id">@r.Partner.FullName (موجودی: @r.Balance.ToString("N0"))</option>
                        }
                    </select>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">مبلغ (تومان) *</label>
                        <input name="Amount" type="number" class="form-control form-control-sm" min="1" step="1000" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">شماره پیگیری واریز</label>
                        <input name="BankTrackingNo" class="form-control form-control-sm" dir="ltr" />
                    </div>
                </div>
                <div class="my-2">
                    <label class="form-label small">توضیح (ردپای مالی) *</label>
                    <input name="Description" class="form-control form-control-sm" required placeholder="مثلاً: سهم پورسانت قرارداد شیرینی سرا — قسط ۱" />
                </div>
                <div class="mb-2">
                    <label class="form-label small">مرجع (اختیاری)</label>
                    <input name="Reference" class="form-control form-control-sm" placeholder="شماره قرارداد مشتری / قسط" />
                </div>
                <div class="mb-3">
                    <label class="form-label small">فیش واریز (PDF یا تصویر)</label>
                    <input type="file" name="receipt" accept=".pdf,.jpg,.jpeg,.png,.webp" class="form-control form-control-sm" />
                </div>
                <button class="btn btn-success btn-sm w-100"><i class="bi bi-cash-coin me-1"></i>ثبت واریز</button>
            </form>
        </div>

        <div class="sn-admin-card">
            <h6 class="mb-3"><i class="bi bi-wallet2 me-2"></i>موجودی همکاران</h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>همکار</th><th>موجودی</th><th>قفل‌شده</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in rows!)
                        {
                            <tr>
                                <td class="small">@r.Partner.FullName</td>
                                <td class="small">@r.Balance.ToString("N0")</td>
                                <td class="small text-warning">@(r.Locked > 0 ? r.Locked.ToString("N0") : "—")</td>
                                <td class="text-end"><a href="/Admin/PortalWallet/Ledger/@r.Partner.Id" class="btn btn-sm btn-outline-secondary">دفتر</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-7">
        <div class="sn-admin-card">
            <h6 class="mb-3"><i class="bi bi-inbox me-2"></i>درخواست‌های برداشت (@pending?.Count)</h6>
            @if (pending is null || !pending.Any())
            {
                <p class="text-muted mb-0">درخواستی در انتظار تایید نیست.</p>
            }
            @foreach (var r in pending!)
            {
                <div class="border rounded-3 p-3 mb-2">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <strong>@r.Partner.FullName</strong>
                            <span class="badge bg-warning text-dark ms-1">@r.Amount.ToString("N0") تومان</span>
                            <div class="small text-muted mt-1">
                                <i class="bi bi-bank me-1"></i>@r.DestinationBank — <span dir="ltr">@r.DestinationIban</span> (به نام @r.DestinationHolder)
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.Note))
                            {
                                <div class="small mt-1">@r.Note</div>
                            }
                            <div class="small text-muted">@r.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2 flex-wrap align-items-end">
                        <form asp-action="ApproveWithdrawal" method="post" class="d-flex gap-1 align-items-center flex-wrap">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input name="bankTrackingNo" class="form-control form-control-sm" dir="ltr" placeholder="شماره پیگیری واریز" style="width:160px" />
                            <input name="response" class="form-control form-control-sm" placeholder="یادداشت (اختیاری)" style="width:160px" />
                            <button class="btn btn-sm btn-success"><i class="bi bi-check2 me-1"></i>تایید و واریز</button>
                        </form>
                        <form asp-action="RejectWithdrawal" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@r.Id" />
                            <input name="response" class="form-control form-control-sm" placeholder="دلیل رد" style="width:150px" />
                            <button class="btn btn-sm btn-outline-danger">رد</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
