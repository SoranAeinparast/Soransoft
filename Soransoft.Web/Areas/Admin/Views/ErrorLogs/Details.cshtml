@model ErrorLog
@{
    ViewData["Title"] = "جزئیات خطا";
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <div class="sn-admin-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">خطا #@Model.Id</h6>
                <span class="badge @(Model.Severity == "Error" ? "bg-danger" : "bg-warning text-dark")">@Model.Severity</span>
            </div>
            <dl class="row">
                <dt class="col-3">تاریخ</dt>
                <dd class="col-9">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm:ss")</dd>
                <dt class="col-3">مسیر</dt>
                <dd class="col-9" dir="ltr">@Model.Path (@Model.HttpMethod)</dd>
                <dt class="col-3">کاربر</dt>
                <dd class="col-9" dir="ltr">@(Model.UserName ?? "—")</dd>
                <dt class="col-3">IP</dt>
                <dd class="col-9" dir="ltr">@(Model.IpAddress ?? "—")</dd>
                <dt class="col-3">منبع</dt>
                <dd class="col-9" dir="ltr">@(Model.Source ?? "—")</dd>
            </dl>
            <hr />
            <h6 class="fw-bold">پیام</h6>
            <p class="mb-3" dir="ltr" style="text-align:left">@Model.Message</p>
            @if (!string.IsNullOrWhiteSpace(Model.StackTrace))
            {
                <h6 class="fw-bold">Stack Trace</h6>
                <pre class="bg-light rounded p-3 small" dir="ltr" style="text-align:left;max-height:400px;overflow:auto">@Model.StackTrace</pre>
            }
        </div>
    </div>
</div>
<div class="mt-3 text-center">
    <a href="/Admin/ErrorLogs" class="btn btn-outline-secondary">بازگشت</a>
</div>
