@model Portfolio
@{
    ViewData["Title"] = "نمونه‌کار جدید";
}
<h5 class="mb-4">نمونه‌کار جدید</h5>
<div class="sn-admin-card">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <partial name="FormFields" model="Model" />
        <button type="submit" class="btn sn-btn-primary">ذخیره</button>
        <a href="/Admin/Portfolios" class="btn btn-outline-secondary">انصراف</a>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
