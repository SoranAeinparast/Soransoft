@model IReadOnlyList<Soransoft.Application.Interfaces.SiteFeatureState>
@{
    ViewData["Title"] = "قابلیت‌های سایت";
    var groups = Model.GroupBy(feature => feature.Group).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h5 class="mb-1">قابلیت‌های سایت</h5>
        <p class="text-muted mb-0">خاموش‌کردن قابلیت، مسیر مستقیم، منو، بخش صفحه و فرم مربوط به آن را همزمان غیرفعال می‌کند.</p>
    </div>
    <a href="/Admin/SiteSettings" class="btn btn-outline-secondary"><i class="bi bi-sliders me-1"></i> تنظیمات متن و اطلاعات</a>
</div>

@foreach (var group in groups)
{
    <section class="sn-admin-card mb-4">
        <h6 class="fw-bold mb-3">@group.Key</h6>
        <div class="row g-3">
            @foreach (var feature in group)
            {
                <div class="col-12 col-xl-6">
                    <div class="border rounded-3 p-3 h-100 d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <strong>@feature.Title</strong>
                                <span class="badge @(feature.IsEnabled ? "bg-success" : "bg-secondary")">@(feature.IsEnabled ? "فعال" : "غیرفعال")</span>
                            </div>
                            <small class="text-muted d-block mt-1">@feature.Description</small>
                            <code dir="ltr" class="small">@feature.Key</code>
                        </div>
                        <form asp-action="Toggle" method="post" class="flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="key" value="@feature.Key" />
                            <button type="submit" class="btn @(feature.IsEnabled ? "btn-outline-danger" : "btn-outline-success")">
                                <i class="bi @(feature.IsEnabled ? "bi-toggle-off" : "bi-toggle-on") me-1"></i>
                                @(feature.IsEnabled ? "غیرفعال‌کردن" : "فعال‌کردن")
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </section>
}
