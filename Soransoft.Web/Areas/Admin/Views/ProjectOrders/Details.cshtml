@model ProjectOrder
@{
    ViewData["Title"] = "جزئیات سفارش";
}
<div class="row g-4">
    <div class="col-12 col-lg-7">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">اطلاعات سفارش #@Model.Id</h6>
            <dl class="row mb-0">
                <dt class="col-4">نام</dt><dd class="col-8">@Model.FullName</dd>
                <dt class="col-4">موبایل</dt><dd class="col-8" dir="ltr">@Model.Mobile</dd>
                <dt class="col-4">ایمیل</dt><dd class="col-8" dir="ltr">@(Model.Email ?? "—")</dd>
                <dt class="col-4">نوع پروژه</dt><dd class="col-8">@Model.ProjectType.ToString()</dd>
                <dt class="col-4">بودجه</dt><dd class="col-8">@(Model.Budget?.ToString("N0") ?? "—") تومان</dd>
                <dt class="col-4">تاریخ ثبت</dt><dd class="col-8">@Model.CreatedAt.ToString("yyyy/MM/dd HH:mm")</dd>
                <dt class="col-4">توضیحات</dt><dd class="col-8">@Model.Description</dd>
            </dl>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="sn-admin-card">
            <h6 class="fw-bold mb-3">تغییر وضعیت</h6>
            <form asp-action="ChangeStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">وضعیت</label>
                    <select name="status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectOrderStatus>()"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">یادداشت مدیر</label>
                    <textarea name="adminNote" class="form-control" rows="4">@Model.AdminNote</textarea>
                </div>
                <button type="submit" class="btn sn-btn-primary w-100">ذخیره</button>
            </form>
        </div>
    </div>
</div>
<div class="mt-3">
    <a href="/Admin/ProjectOrders" class="btn btn-outline-secondary">بازگشت</a>
</div>
