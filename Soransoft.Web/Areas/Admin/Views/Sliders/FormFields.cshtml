@model Slider
<div class="mb-3">
    <label class="form-label">عنوان</label>
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger small"></span>
</div>
<div class="mb-3">
    <label class="form-label">زیرعنوان</label>
    <input asp-for="SubTitle" class="form-control" />
</div>
<div class="mb-3">
    <label class="form-label">لینک (اختیاری)</label>
    <input asp-for="Link" class="form-control" dir="ltr" list="site-page-links" placeholder="/OrderProject" />
    <datalist id="site-page-links">
        @if (ViewBag.Pages is List<SitePage> pages)
        {
            @foreach (var page in pages)
            {
                <option value="/Page/@Uri.EscapeDataString(page.Slug)">@(page.Title)</option>
            }
        }
    </datalist>
    <small class="text-muted">برای اتصال به صفحه پویا، عنوان صفحه را از پیشنهادها انتخاب کنید.</small>
</div>
<div class="mb-3">
    <label class="form-label">تصویر پس‌زمینه</label>
    <partial name="_MediaImagePicker" model="Model.Image" view-data="@(new ViewDataDictionary(ViewData) { ["MediaInputName"] = "Image", ["MediaInputId"] = "slider-image-input", ["MediaPreviewId"] = "slider-image-preview" })" />
</div>
<div class="row g-3">
    <div class="col-md-4 mb-3">
        <div class="form-check form-switch">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label">ترتیب نمایش</label>
        <input asp-for="DisplayOrder" class="form-control" type="number" />
    </div>
</div>
