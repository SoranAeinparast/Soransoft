@model List<Service>
@{
    ViewData["Title"] = "مدیریت سرویس‌ها";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">سرویس‌ها</h5>
    <a href="/Admin/Services/Create" class="btn sn-btn-primary"><i class="bi bi-plus-lg me-1"></i> سرویس جدید</a>
</div>

<div class="sn-admin-card">
    <div class="table-responsive">
        <table class="table sn-admin-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>عنوان</th>
                    <th>نوع</th>
                    <th>اسلاگ</th>
                    <th>به‌زودی</th>
                    <th>فعال</th>
                    <th>ترتیب</th>
                    <th>ویژگی‌ها و مراحل</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Kind.ToString()</td>
                        <td dir="ltr">@item.Slug</td>
                        <td>@(item.ComingSoon ? "بله" : "خیر")</td>
                        <td>@(item.IsActive ? "بله" : "خیر")</td>
                        <td>@item.DisplayOrder</td>
                        <td style="min-width:340px">
                            <details>
                                <summary class="small text-primary" style="cursor:pointer">مدیریت ویژگی‌ها (@item.Features.Count) و مراحل (@item.Steps.Count)</summary>
                                <div class="border rounded p-2 mt-2 bg-light">
                                    <strong class="small d-block mb-1">ویژگی‌ها</strong>
                                    @foreach (var feature in item.Features.OrderBy(f => f.DisplayOrder))
                                    {
                                        <form asp-action="EditFeature" method="post" class="d-flex gap-1 align-items-center mb-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@feature.Id" />
                                            <input name="title" value="@feature.Title" class="form-control form-control-sm" required />
                                            <input name="description" value="@feature.Description" class="form-control form-control-sm" placeholder="توضیح" />
                                            <input name="displayOrder" value="@feature.DisplayOrder" type="number" class="form-control form-control-sm" style="width:65px" />
                                            <button class="btn btn-sm btn-outline-primary" title="ذخیره"><i class="bi bi-check2"></i></button>
                                        </form>
                                        <form asp-action="DeleteFeature" method="post" class="d-inline" onsubmit="return confirm('این ویژگی حذف شود؟')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@feature.Id" />
                                            <button class="btn btn-sm btn-link text-danger p-0 mb-1">حذف ویژگی</button>
                                        </form>
                                    }
                                    <form asp-action="AddFeature" method="post" class="row g-1 mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="serviceId" value="@item.Id" />
                                        <div class="col-4"><input name="title" class="form-control form-control-sm" required placeholder="ویژگی جدید" /></div>
                                        <div class="col-5"><input name="description" class="form-control form-control-sm" placeholder="توضیح" /></div>
                                        <div class="col-2"><input name="displayOrder" type="number" value="0" class="form-control form-control-sm" /></div>
                                        <div class="col-1"><button class="btn btn-sm btn-outline-secondary w-100" title="افزودن"><i class="bi bi-plus"></i></button></div>
                                    </form>
                                    <hr class="my-2" />
                                    <strong class="small d-block mb-1">مراحل اجرا</strong>
                                    @foreach (var step in item.Steps.OrderBy(s => s.DisplayOrder))
                                    {
                                        <form asp-action="EditStep" method="post" class="d-flex gap-1 align-items-center mb-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@step.Id" />
                                            <input name="title" value="@step.Title" class="form-control form-control-sm" required />
                                            <input name="displayOrder" value="@step.DisplayOrder" type="number" class="form-control form-control-sm" style="width:65px" />
                                            <button class="btn btn-sm btn-outline-primary" title="ذخیره"><i class="bi bi-check2"></i></button>
                                        </form>
                                        <form asp-action="DeleteStep" method="post" class="d-inline" onsubmit="return confirm('این مرحله حذف شود؟')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@step.Id" />
                                            <button class="btn btn-sm btn-link text-danger p-0 mb-1">حذف مرحله</button>
                                        </form>
                                    }
                                    <form asp-action="AddStep" method="post" class="d-flex gap-1 mt-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="serviceId" value="@item.Id" />
                                        <input name="title" class="form-control form-control-sm" required placeholder="مرحله جدید" />
                                        <input name="displayOrder" type="number" value="0" class="form-control form-control-sm" style="width:65px" />
                                        <button class="btn btn-sm btn-outline-secondary" title="افزودن"><i class="bi bi-plus"></i></button>
                                    </form>
                                </div>
                            </details>
                        </td>
                        <td class="text-nowrap">
                            <a href="/Admin/Services/Edit/@item.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                            <form method="post" action="/Admin/Services/Delete/@item.Id" class="d-inline"
                                  onsubmit="return confirm('حذف شود؟')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
