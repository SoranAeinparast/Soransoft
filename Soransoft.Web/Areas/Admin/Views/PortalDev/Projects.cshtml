@model List<Soransoft.Domain.Entities.DevProject>
@{
    ViewData["Title"] = "پروژه‌های تیم فنی";
    var devs = ViewBag.Devs as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<h5 class="mb-3"><i class="bi bi-diagram-3 me-2"></i>پروژه‌ها (@Model.Count)</h5>

<div class="sn-admin-card mb-3">
    <form asp-action="CreateProject" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-12 col-md-4">
            <label class="form-label small">عنوان پروژه *</label>
            <input name="title" class="form-control form-control-sm" required placeholder="مثلاً: SugarShop" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small">توضیح</label>
            <input name="description" class="form-control form-control-sm" />
        </div>
        <div class="col-9 col-md-3">
            <label class="form-label small">وضعیت کلی</label>
            <input name="statusText" class="form-control form-control-sm" placeholder="مثلاً: در مرحله تست" />
        </div>
        <div class="col-3 col-md-1">
            <button class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg"></i></button>
        </div>
    </form>
</div>

<div class="row g-3">
    @foreach (var p in Model)
    {
        var done = p.Tasks.Count(t => t.Status == Soransoft.Domain.Entities.TaskStatus.Done);
        var total = p.Tasks.Count;
        <div class="col-12 col-lg-6">
            <div class="sn-admin-card h-100">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h6 class="mb-1">@p.Title</h6>
                        <div class="small text-muted">@p.Description</div>
                    </div>
                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#dev-project-@p.Id"><i class="bi bi-sliders me-1"></i>مدیریت پروژه</button>
                </div>
                <div class="small mt-2 text-muted">@p.Tasks.Count تسک · @p.Members.Count عضو · @(p.IsActive ? "فعال" : "غیرفعال")</div>
                <div class="collapse mt-3" id="dev-project-@p.Id">
                    <form asp-action="EditProject" method="post" class="row g-1 align-items-center mb-3 border rounded p-2 bg-light">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@p.Id" />
                        <div class="col-12 col-md-3"><input name="Title" class="form-control form-control-sm" value="@p.Title" required placeholder="عنوان" /></div>
                        <div class="col-12 col-md-3"><input name="Description" class="form-control form-control-sm" value="@p.Description" placeholder="توضیح" /></div>
                        <div class="col-12 col-md-2"><input name="StatusText" class="form-control form-control-sm" value="@p.StatusText" placeholder="وضعیت" /></div>
                        <input type="hidden" name="IsActive" value="false" />
                        <label class="form-check form-check-inline small mb-0 col-auto"><input type="checkbox" name="IsActive" value="true" class="form-check-input" @(p.IsActive ? "checked" : "") /> فعال</label>
                        <button class="btn btn-sm btn-outline-primary col-auto" title="ذخیره پروژه"><i class="bi bi-save"></i></button>
                        <button type="submit" formaction="/Admin/PortalDev/DeleteProject" name="id" value="@p.Id" formmethod="post" class="btn btn-sm btn-outline-danger col-auto" onclick="return confirm('پروژه حذف شود؟ سابقه تسک‌ها حفظ می‌شود.')"><i class="bi bi-trash"></i></button>
                    </form>
                @if (total > 0)
                {
                    <div class="small mt-2">
                        پیشرفت: @done از @total تسک
                        <div class="progress mt-1" style="height:8px">
                            <div class="progress-bar bg-success" style="width:@(done * 100 / total)%"></div>
                        </div>
                    </div>
                }
                <hr class="my-2" />
                <div class="small mb-2"><strong>اعضا:</strong>
                    @if (p.Members.Any())
                    {
                        @foreach (var m in p.Members)
                        {
                            <form asp-action="EditMember" method="post" class="d-inline-flex gap-1 align-items-center ms-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <span class="badge bg-light text-dark border">@m.Partner.FullName</span>
                                <input name="roleInProject" value="@m.RoleInProject" class="form-control form-control-sm" placeholder="نقش" style="width:110px" />
                                <button class="btn btn-sm btn-link p-0" title="ذخیره نقش"><i class="bi bi-check2"></i></button>
                            </form>
                            <form asp-action="DeleteMember" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                <button class="btn btn-sm btn-link p-0 text-danger" title="حذف عضو" onclick="return confirm('این عضو از پروژه حذف شود؟')"><i class="bi bi-x"></i></button>
                            </form>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </div>
                <form asp-action="AddMember" method="post" class="d-flex gap-1 align-items-center">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@p.Id" />
                    <select name="partnerId" class="form-select form-select-sm" required style="max-width:180px">
                        <option value="">افزودن عضو...</option>
                        @foreach (var d in devs)
                        {
                            <option value="@d.Id">@d.FullName</option>
                        }
                    </select>
                    <input name="roleInProject" class="form-control form-control-sm" placeholder="نقش (مثلاً Backend)" style="max-width:130px" />
                    <button class="btn btn-sm btn-outline-secondary"><i class="bi bi-person-plus"></i></button>
                </form>
                </div>
            </div>
        </div>
    }
</div>

<div class="d-flex justify-content-end mt-3">
    <a asp-action="Sprints" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar3 me-1"></i>مدیریت اسپرینت‌ها</a>
</div>
