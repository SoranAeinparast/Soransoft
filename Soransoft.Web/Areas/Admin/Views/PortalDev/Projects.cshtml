@model List<Soransoft.Domain.Entities.DevProject>
@{
    ViewData["Title"] = "پروژه‌های تیم فنی";
    var devs = ViewBag.Devs as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="sn-dev-projects-page">
<div class="d-flex justify-content-between align-items-end gap-3 mb-3 flex-wrap">
    <div>
        <h5 class="mb-1"><i class="bi bi-diagram-3 me-2"></i>پروژه‌های تیم فنی</h5>
        <p class="text-muted small mb-0">پروژه‌ها، اعضای تیم و وضعیت پیشرفت را از این بخش مدیریت کنید.</p>
    </div>
    <span class="badge bg-secondary">@Model.Count پروژه</span>
</div>

<div class="sn-admin-card mb-3">
    <h6 class="mb-3"><i class="bi bi-plus-circle me-2"></i>ساخت پروژه جدید</h6>
    <form asp-action="CreateProject" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-12 col-md-4">
            <label class="form-label small">عنوان پروژه *</label>
            <input name="title" class="form-control form-control-sm" required placeholder="مثلاً: SugarShop" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label small">توضیح</label>
            <input name="description" class="form-control form-control-sm" />
        </div>
        <div class="col-9 col-md-3">
            <label class="form-label small">وضعیت کلی</label>
            <input name="statusText" class="form-control form-control-sm" placeholder="مثلاً: در مرحله تست" />
        </div>
        <div class="col-12 col-md-1">
            <button class="btn btn-primary btn-sm w-100"><i class="bi bi-plus-lg me-1"></i>افزودن</button>
        </div>
    </form>
</div>

<div class="row g-3 align-items-start">
    @foreach (var p in Model)
    {
        var done = p.Tasks.Count(t => t.Status == Soransoft.Domain.Entities.TaskStatus.Done);
        var total = p.Tasks.Count;
        <div class="col-12 col-lg-6">
            <article class="sn-admin-card sn-dev-project-card">
                <div class="sn-dev-project-head">
                    <div>
                        <h6 class="mb-1">@p.Title</h6>
                        <p class="small text-muted mb-0">@(string.IsNullOrWhiteSpace(p.Description) ? "بدون توضیح" : p.Description)</p>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">@(p.IsActive ? "فعال" : "غیرفعال")</span>
                        <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#dev-project-@p.Id" aria-controls="dev-project-@p.Id"><i class="bi bi-sliders me-1"></i>مدیریت</button>
                    </div>
                </div>
                <div class="sn-dev-project-stats">
                    <span><i class="bi bi-list-check"></i>@p.Tasks.Count تسک</span>
                    <span><i class="bi bi-people"></i>@p.Members.Count عضو</span>
                    <span><i class="bi bi-activity"></i>@(string.IsNullOrWhiteSpace(p.StatusText) ? "وضعیت ثبت نشده" : p.StatusText)</span>
                </div>
                @if (total > 0)
                {
                    <div class="sn-dev-progress">
                        <div class="d-flex justify-content-between small text-muted"><span>پیشرفت</span><span>@done از @total تسک</span></div>
                        <div class="progress mt-1" style="height:8px"><div class="progress-bar bg-success" style="width:@(done * 100 / total)%"></div></div>
                    </div>
                }
                <div class="collapse mt-3" id="dev-project-@p.Id">
                    <form asp-action="EditProject" method="post" class="sn-dev-project-editor mb-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Id" value="@p.Id" />
                        <div class="sn-dev-field sn-dev-field-title"><label for="project-title-@p.Id">عنوان پروژه</label><input id="project-title-@p.Id" name="Title" class="form-control form-control-sm" value="@p.Title" required /></div>
                        <div class="sn-dev-field sn-dev-field-description"><label for="project-description-@p.Id">توضیح</label><input id="project-description-@p.Id" name="Description" class="form-control form-control-sm" value="@p.Description" /></div>
                        <div class="sn-dev-field sn-dev-field-status"><label for="project-status-@p.Id">وضعیت کلی</label><input id="project-status-@p.Id" name="StatusText" class="form-control form-control-sm" value="@p.StatusText" /></div>
                        <label class="sn-dev-active-check" for="project-active-@p.Id"><input id="project-active-@p.Id" type="checkbox" name="IsActive" value="true" class="form-check-input" @(p.IsActive ? "checked" : "") /> فعال</label>
                        <input type="hidden" name="IsActive" value="false" />
                        <div class="sn-dev-editor-actions"><button class="btn btn-sm btn-outline-primary" title="ذخیره پروژه"><i class="bi bi-save me-1"></i>ذخیره</button><button type="submit" formaction="/Admin/PortalDev/DeleteProject" name="id" value="@p.Id" formmethod="post" class="btn btn-sm btn-outline-danger" data-swal-confirm="پروژه حذف شود؟ سابقه تسک‌ها حفظ می‌شود."><i class="bi bi-trash"></i></button></div>
                    </form>
                <section class="sn-dev-members">
                    <div class="sn-dev-subheading"><strong>اعضای پروژه</strong><span>@p.Members.Count نفر</span></div>
                    @if (p.Members.Any())
                    {
                        @foreach (var m in p.Members)
                        {
                            <div class="sn-dev-member-row">
                                <span class="badge bg-light text-dark border">@m.Partner.FullName</span>
                                <form asp-action="EditMember" method="post" class="sn-dev-member-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.Id" />
                                    <input name="roleInProject" value="@m.RoleInProject" class="form-control form-control-sm" placeholder="نقش عضو" aria-label="نقش عضو" />
                                    <button class="btn btn-sm btn-link p-0" title="ذخیره نقش"><i class="bi bi-check2"></i></button>
                                </form>
                                <form asp-action="DeleteMember" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button class="btn btn-sm btn-link p-0 text-danger" title="حذف عضو" data-swal-confirm="این عضو از پروژه حذف شود؟"><i class="bi bi-x"></i></button>
                                </form>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                </section>
                <form asp-action="AddMember" method="post" class="sn-dev-add-member">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="projectId" value="@p.Id" />
                    <label for="add-member-@p.Id">افزودن عضو</label>
                    <select id="add-member-@p.Id" name="partnerId" class="form-select form-select-sm" required>
                        <option value="">افزودن عضو...</option>
                        @foreach (var d in devs)
                        {
                            <option value="@d.Id">@d.FullName</option>
                        }
                    </select>
                    <input name="roleInProject" class="form-control form-control-sm" placeholder="نقش (مثلاً Backend)" aria-label="نقش عضو جدید" />
                    <button class="btn btn-sm btn-outline-secondary" title="افزودن عضو"><i class="bi bi-person-plus me-1"></i>افزودن</button>
                </form>
                </div>
            </article>
        </div>
    }
</div>

<div class="d-flex justify-content-end mt-3">
    <a asp-action="Sprints" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar3 me-1"></i>مدیریت اسپرینت‌ها</a>
</div>
</div>
