@model List<Soransoft.Domain.Entities.Sprint>
@{
    ViewData["Title"] = "اسپرینت‌های تیم فنی";
    var taskCounts = ViewBag.TaskCounts as Dictionary<int, int> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="mb-0"><i class="bi bi-calendar3 me-2"></i>اسپرینت‌های تیم فنی (@Model.Count)</h5>
    <a asp-action="Projects" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>بازگشت به پروژه‌ها</a>
</div>

<div class="sn-admin-card mb-3">
    <h6 class="mb-3"><i class="bi bi-plus-circle me-2"></i>ساخت اسپرینت</h6>
    <form asp-action="CreateSprint" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-12 col-md-3">
            <label class="form-label small">عنوان *</label>
            <input name="Title" class="form-control form-control-sm" required placeholder="مثلاً: اسپرینت فروردین" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">شروع</label>
            <input name="StartDate" type="text" data-persian-date class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small">پایان</label>
            <input name="EndDate" type="text" data-persian-date class="form-control form-control-sm" />
        </div>
        <div class="col-12 col-md-3">
            <label class="form-label small">هدف</label>
            <input name="Goal" class="form-control form-control-sm" />
        </div>
        <div class="col-6 col-md-1">
            <input type="hidden" name="IsActive" value="false" />
            <div class="form-check"><input type="checkbox" name="IsActive" value="true" class="form-check-input" id="newSprintActive" checked /><label class="form-check-label small" for="newSprintActive">فعال</label></div>
        </div>
        <div class="col-6 col-md-1"><button class="btn btn-sm btn-primary w-100">ساخت</button></div>
    </form>
</div>

<div class="sn-admin-card">
    @if (!Model.Any())
    {
        <p class="text-muted mb-0">اسپرینتی ثبت نشده است.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>عنوان</th><th>بازه</th><th>هدف</th><th>تسک‌ها</th><th>وضعیت</th><th></th></tr></thead>
                <tbody>
                    @foreach (var sprint in Model)
                    {
                        var count = taskCounts.TryGetValue(sprint.Id, out var value) ? value : 0;
                        <tr>
                            <td colspan="6">
                                <form asp-action="EditSprint" method="post" class="row g-1 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@sprint.Id" />
                                    <div class="col-12 col-md-3"><input name="Title" value="@sprint.Title" class="form-control form-control-sm" required /></div>
                                    <div class="col-6 col-md-2"><input name="StartDate" type="text" data-persian-date value="@PersianDisplay.Date(sprint.StartDate)" class="form-control form-control-sm" /></div>
                                    <div class="col-6 col-md-2"><input name="EndDate" type="text" data-persian-date value="@PersianDisplay.Date(sprint.EndDate)" class="form-control form-control-sm" /></div>
                                    <div class="col-12 col-md-2"><input name="Goal" value="@sprint.Goal" class="form-control form-control-sm" placeholder="هدف" /></div>
                                    <div class="col-6 col-md-1 small">@count تسک</div>
                                    <div class="col-6 col-md-1">
                                        <input type="hidden" name="IsActive" value="false" />
                                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" @(sprint.IsActive ? "checked" : "") />
                                        <span class="small">فعال</span>
                                    </div>
                                    <div class="col-12 col-md-1 d-flex gap-1 justify-content-end">
                                        <button class="btn btn-sm btn-outline-primary" title="ذخیره"><i class="bi bi-check2"></i></button>
                                        <button type="submit" formaction="/Admin/PortalDev/DeleteSprint" name="id" value="@sprint.Id" formmethod="post" class="btn btn-sm btn-outline-danger" data-swal-confirm="اسپرینت حذف شود؟"><i class="bi bi-trash"></i></button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
