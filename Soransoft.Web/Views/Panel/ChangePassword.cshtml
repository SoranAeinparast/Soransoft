@model Soransoft.Application.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}
<section class="sn-page-hero">
    <div class="container text-center">
        <h1 class="sn-hero-title">تغییر رمز عبور</h1>
    </div>
</section>

<section class="sn-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5">
                <div class="sn-form-card">
                    @if (TempData["Success"] is string success)
                    {
                        <div class="alert alert-success text-center">@success</div>
                    }
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label"></label>
                            <input asp-for="CurrentPassword" class="form-control sn-input" dir="ltr" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label"></label>
                            <input asp-for="NewPassword" class="form-control sn-input" dir="ltr" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ConfirmNewPassword" class="form-label"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control sn-input" dir="ltr" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                        <div asp-validation-summary="All" class="text-danger small mb-2"></div>
                        <button type="submit" class="btn sn-btn-primary w-100">تغییر رمز عبور</button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="/Panel/Profile" class="small">بازگشت به پروفایل</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
