@using Soransoft.Application.Interfaces
@using Soransoft.Application.ViewModels
@using System.Security.Claims
@inject ISiteService Site
@inject ISiteSettingService Settings
@{
    var mainMenu = await Site.GetMenuAsync(Soransoft.Domain.Enums.MenuPosition.Main);
    var footerMenu = await Site.GetMenuAsync(Soransoft.Domain.Enums.MenuPosition.Footer);
    var siteSettings = await Settings.GetAllAsync();
    string S(string key, string def = "") => siteSettings.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : def;

    // کاربر عادی واردشده (اسکیم UserAuth)
    var isSiteUser = User.Identity?.IsAuthenticated == true && User.HasClaim("UserType", "SiteUser");
    var siteUserName = User.FindFirstValue(ClaimTypes.Name);

    // همکار واردشده (اسکیم PartnerAuth) — ورود فقط از پرتال همکاران ممکن است
    var isPartner = User.Identity?.IsAuthenticated == true && User.HasClaim("UserType", "Partner");
    var partnerName = User.FindFirstValue(ClaimTypes.Name);

    // ---------- سئو: Open Graph / Twitter Card / Canonical ----------
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host.Value}".TrimEnd('/');
    var pageTitle = ViewData["Title"] != null ? $"{ViewData["Title"]} | {S("SiteName")}" : $"{S("SiteName")} | {S("SiteDescription", "طراحی سایت و اپلیکیشن")}";
    var pageDescription = ViewData["Description"] as string ?? S("SiteDescription");
    var canonicalUrl = ViewData["Canonical"] as string ?? baseUrl + Context.Request.Path.Value;
    var ogType = ViewData["OgType"] as string ?? "website";
    var ogImage = ViewData["OgImage"] as string;
    if (string.IsNullOrWhiteSpace(ogImage))
    {
        var configured = S("OgImage");
        ogImage = string.IsNullOrWhiteSpace(configured) ? null : (configured.StartsWith("http") ? configured : baseUrl + "/" + configured.TrimStart('~', '/'));
    }
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@canonicalUrl" />

    @* ---- Open Graph ---- *@
    <meta property="og:site_name" content="@S("SiteName")" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:locale" content="fa_IR" />
    @if (ogImage is not null)
    {
        <meta property="og:image" content="@ogImage" />
    }
    @if (ViewData["ArticlePublishedTime"] is string publishedTime)
    {
        <meta property="article:published_time" content="@publishedTime" />
    }

    @* ---- Twitter Card ---- *@
    <meta name="twitter:card" content="@(ogImage is null ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    @if (ogImage is not null)
    {
        <meta name="twitter:image" content="@ogImage" />
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" onerror="this.onerror=null;this.href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css'" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sn-header">
        <div class="container">
            <nav class="sn-nav d-none d-lg-flex align-items-center justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="sn-logo">@S("LogoText", "SORANSOFT")</a>
                <ul class="sn-menu list-unstyled d-flex align-items-center gap-4 mb-0">
                    @foreach (var item in mainMenu)
                    {
                        <li><a href="@item.Url" class="sn-menu-link">@item.Title</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="sn-theme-toggle" id="snThemeToggle" aria-label="تغییر حالت روز/شب" title="حالت روز / شب">
                        <i class="bi bi-sun"></i>
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    @if (isPartner)
                    {
                        <a href="/Partner/Dashboard" class="btn btn-sm sn-btn-primary"><i class="bi bi-briefcase me-1"></i> پرتال (@partnerName)</a>
                    }
                    else
                    {
                        <a href="/Partner/Account/Login" class="btn btn-sm sn-btn-portal"><i class="bi bi-briefcase me-1"></i> پرتال همکاران</a>
                    }
                    @if (isSiteUser)
                    {
                        <a href="/Panel" class="btn btn-sm sn-btn-primary"><i class="bi bi-person-circle me-1"></i> @siteUserName</a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-sm sn-btn-outline">ورود / عضویت</a>
                    }
                </div>
            </nav>
            <nav class="sn-nav-mobile d-flex d-lg-none align-items-center justify-content-between">
                <a asp-controller="Home" asp-action="Index" class="sn-logo">@S("LogoText", "SORANSOFT")</a>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="sn-theme-toggle" id="snThemeToggleM" aria-label="تغییر حالت روز/شب">
                        <i class="bi bi-sun"></i>
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <button class="sn-burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="منو">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </nav>
        </div>
    </header>

    <!-- منوی موبایل -->
    <div class="offcanvas offcanvas-start sn-mobile-menu" tabindex="-1" id="mobileMenu">
        <div class="offcanvas-header">
            <span class="sn-logo">@S("LogoText", "SORANSOFT")</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="بستن"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="list-unstyled">
                @foreach (var item in mainMenu)
                {
                    <li><a href="@item.Url" class="sn-mobile-link">@item.Title</a></li>
                }
                <li><a href="/Partner/Account/Login" class="sn-mobile-link"><i class="bi bi-briefcase me-2"></i>پرتال همکاران</a></li>
                @if (isSiteUser)
                {
                    <li><a href="/Account/Logout" class="sn-mobile-link">خروج از حساب</a></li>
                }
            </ul>
            @if (isSiteUser)
            {
                <a href="/Panel" class="btn sn-btn-primary w-100 mt-3"><i class="bi bi-person-circle me-1"></i> پنل کاربری (@siteUserName)</a>
            }
            else
            {
                <a href="/Account/Login" class="btn sn-btn-primary w-100 mt-3">ورود / عضویت</a>
            }
        </div>
    </div>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="sn-footer">
        <div class="container">
            <h6 class="sn-footer-title">ما را دنــــــــــــــــــــــــبال کنید</h6>
            <div class="d-flex justify-content-center gap-3 mb-5">
                @if (!string.IsNullOrWhiteSpace(S("InstagramUrl")))
                {
                    <a href="@S("InstagramUrl")" target="_blank" rel="noopener" class="sn-social"><i class="bi bi-instagram"></i></a>
                }
                @if (!string.IsNullOrWhiteSpace(S("TelegramUrl")))
                {
                    <a href="@S("TelegramUrl")" target="_blank" rel="noopener" class="sn-social"><i class="bi bi-telegram"></i></a>
                }
                @if (!string.IsNullOrWhiteSpace(S("WhatsappUrl")))
                {
                    <a href="@S("WhatsappUrl")" target="_blank" rel="noopener" class="sn-social"><i class="bi bi-whatsapp"></i></a>
                }
            </div>
            <div class="row g-4 align-items-start">
                <div class="col-12 col-md-4">
                    <ul class="list-unstyled d-flex flex-column gap-2">
                        @foreach (var item in footerMenu)
                        {
                            <li><a href="@item.Url" class="sn-footer-link">@item.Title</a></li>
                        }
                    </ul>
                </div>
                <div class="col-12 col-md-4">
                    <p class="mb-2"><i class="bi bi-geo-alt me-2"></i>@S("Address")</p>
                    <p class="mb-2"><i class="bi bi-telephone me-2"></i><span dir="ltr">@S("Phone")</span></p>
                    <p class="mb-0"><i class="bi bi-envelope me-2"></i><span dir="ltr">@S("Email")</span></p>
                </div>
                <div class="col-12 col-md-4 text-center text-md-start">
                    <a asp-controller="Home" asp-action="Index" class="sn-logo">@S("LogoText", "SORANSOFT")</a>
                </div>
            </div>
            <div class="sn-footer-bottom text-center mt-4 pt-3">
                @S("FooterNote", "Designed with ❤️ by Soransoft team")
            </div>
        </div>
    </footer>

    @* نوار سبز چسبان مشاوره — مشابه stick_message مرجع *@
    <div class="sn-stick-message" id="snStickMessage">
        <p>جهت دریافت مشاوره رایگان <a href="/ContactUs">اینجا کلیک کنید</a> یا با ما تماس بگیرید</p>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="sn-toast sn-toast-success" id="snToast">@success</div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
