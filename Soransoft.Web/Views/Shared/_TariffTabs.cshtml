@using Soransoft.Domain.Enums
@using Soransoft.Application.Interfaces
@model List<Soransoft.Application.ViewModels.TariffSectionViewModel>
@inject ISiteSettingService Settings
@inject ISiteFeatureService Features
@{
    static string KindTitle(ServiceKind kind) => kind switch
    {
        ServiceKind.Site => "طراحی سایت",
        ServiceKind.Seo => "سـئو",
        ServiceKind.Application => "اپلیکیشن",
        _ => "تولید محتوا",
    };
    var settings = await Settings.GetAllAsync();
    string S(string key, string def = "") => settings.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : def;
    var orderEnabled = await Features.IsEnabledAsync(SiteFeatures.ProjectOrder);
}
<ul class="nav sn-tabs justify-content-center mb-4" role="tablist">
    @foreach (var tabSection in Model)
    {
        var isFirstTab = tabSection.Id == Model.First().Id;
        <li class="nav-item" role="presentation">
            <button class="nav-link @(isFirstTab ? "active" : "")" data-bs-toggle="tab"
                    data-bs-target="#tariff-section-@tabSection.Id" aria-controls="tariff-section-@tabSection.Id" aria-selected="@(isFirstTab ? "true" : "false")" type="button" role="tab">
                @(string.IsNullOrWhiteSpace(tabSection.Title) ? KindTitle(tabSection.Kind) : tabSection.Title)
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    @foreach (var tabSection in Model)
    {
        var isFirstPanel = tabSection.Id == Model.First().Id;
        <div class="tab-pane fade @(isFirstPanel ? "show active" : "")" id="tariff-section-@tabSection.Id" role="tabpanel" tabindex="0">
            <div class="row g-4 justify-content-center">
                @foreach (var package in tabSection.Packages)
                {
                    <div class="col-12 col-md-6 col-lg-3">
                        <div class="sn-price-card @(package.IsPopular ? "sn-popular" : "")">
                            @if (package.IsPopular)
                            {
                                <span class="sn-popular-badge">@S("TariffPopularLabel", "محبوب")</span>
                            }
                            <h3>@package.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(package.Duration))
                            {
                                <p class="sn-price-duration">@package.Duration</p>
                            }
                            <ul class="sn-price-features list-unstyled">
                                @if (package.IsInstallmentAvailable)
                                {
                                    <li><i class="bi bi-check2"></i> @S("TariffInstallmentLabel", "امکان اقساط")</li>
                                }
                                @if (package.HasFreeSupport)
                                {
                                    <li><i class="bi bi-check2"></i> @S("TariffSupportLabel", "1 سال پشتیبانی رایگان")</li>
                                }
                                @foreach (var item in package.Items)
                                {
                                    <li><i class="bi bi-check2"></i> @item</li>
                                }
                            </ul>
                            <div class="sn-price">
                                @if (package.Price.HasValue)
                                {
                                    <span class="sn-price-value">@package.Price.Value.ToString("N0")</span>
                                    <span class="sn-price-unit">تومان</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(package.PriceNote))
                                {
                                    <span class="sn-price-note">@package.PriceNote</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(package.PriceSuffix))
                                {
                                    <span class="sn-price-note">@package.PriceSuffix</span>
                                }
                            </div>
                            @if (orderEnabled)
                            {
                                <a href="/OrderProject" class="btn sn-btn-primary w-100">@S("TariffOrderCta", "سفارش")</a>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (tabSection.Kind == ServiceKind.Content)
            {
                <p class="text-center text-muted mt-3 small">@S("TariffContentNote", "برای سایت دو زبانه 20 درصد به مبالغ فوق اضافه می شود")</p>
            }
        </div>
    }
</div>
