@using Soransoft.Domain.Enums
@model Soransoft.Application.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "تعرفه";
    string S(string key, string def = "") => Model.Settings.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : def;
}
<section class="sn-page-hero">
    <div class="container text-center">
        <h1 class="sn-hero-title">@S("TariffHeroTitle", "تعرفه‌های خدمات")</h1>
        <p class="sn-hero-text">@S("TariffHeroText", "تعرفه ها حدودی هستند و طبیعتا بنا بر نیاز شما تغییر می کنند")</p>
    </div>
</section>

<section class="sn-section">
    <div class="container">
        <partial name="_TariffTabs" model="Model.TariffSections" />

        <div class="sn-consultation mt-5">
            <partial name="_ConsultationForm" model="new Soransoft.Application.ViewModels.ConsultationRequestViewModel()" />
        </div>
    </div>
</section>
