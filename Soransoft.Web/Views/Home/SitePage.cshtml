@using Soransoft.Application.ViewModels
@model Soransoft.Domain.Entities.SitePage
@{
    var isIncoming = string.Equals(Model.Slug, "incoming", StringComparison.OrdinalIgnoreCase);
    var isShirinisara = string.Equals(Model.Slug, "shirinisara", StringComparison.OrdinalIgnoreCase);
    var marketing = ViewData["MarketingInterest"] as MarketingInterestViewModel ?? new MarketingInterestViewModel();
    const string marketingFormMarker = "<!-- soransoft-marketing-form -->";
    var sanitizedBody = SafeHtml.Sanitize(Model.Body);
    var markerIndex = isIncoming ? sanitizedBody.IndexOf(marketingFormMarker, StringComparison.Ordinal) : -1;
    var bodyBeforeForm = markerIndex >= 0 ? sanitizedBody[..markerIndex] : sanitizedBody;
    var bodyAfterForm = markerIndex >= 0 ? sanitizedBody[(markerIndex + marketingFormMarker.Length)..] : string.Empty;
    var pageContainerClass = isIncoming || isShirinisara ? "container-fluid sn-feature-wide-container" : "container";
}

<section class="sn-page-hero @(isIncoming ? "sn-incoming-hero" : isShirinisara ? "sn-shirinisara-hero" : "")">
    <div class="container text-center">
        @if (isIncoming)
        {
            <span class="sn-section-kicker"><i class="bi bi-stars"></i> شبکه همکاران فروش Soransoft</span>
        }
        <h1 class="sn-hero-title">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Summary))
        {
            <p class="sn-hero-subtitle">@Model.Summary</p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Image))
        {
            <img src="~/@Model.Image.TrimStart('~', '/')" alt="@Model.Title" class="img-fluid rounded shadow-sm mt-3" style="max-height:320px;object-fit:cover" />
        }
        @if (isIncoming)
        {
            <div class="sn-incoming-hero-actions">
                <a href="#marketing-interest" class="btn sn-btn-primary"><i class="bi bi-send me-1"></i>اعلام آمادگی همکاری</a>
                <a href="/Partner/Account/Login" class="btn sn-btn-outline"><i class="bi bi-box-arrow-in-left me-1"></i>ورود همکاران</a>
            </div>
        }
        @if (isShirinisara)
        {
            <div class="sn-shirinisara-hero-actions">
                <a href="/ContactUs" class="btn sn-btn-warm"><i class="bi bi-chat-heart me-1"></i>درخواست مشاوره و راه‌اندازی</a>
                <a href="#shirinisara-features" class="btn sn-btn-outline"><i class="bi bi-grid-3x3-gap me-1"></i>مشاهده امکانات پلتفرم</a>
            </div>
        }
    </div>
</section>

<section class="sn-section @(isIncoming ? "sn-incoming-content-section" : isShirinisara ? "sn-shirinisara-content-section" : "")">
    <div class="@pageContainerClass">
        <article class="sn-article-body-content @(isIncoming ? "sn-incoming-content" : isShirinisara ? "sn-shirinisara-content" : "")">
            @Html.Raw(bodyBeforeForm)
        </article>
    </div>
</section>

@if (isIncoming)
{
    <section class="sn-section sn-section-alt sn-incoming-form-section" id="marketing-interest">
        <div class="@pageContainerClass">
            <div class="sn-incoming-form-shell">
                <div class="sn-form-card sn-incoming-form-card">
                    <form action="/Page/incoming/MarketingInterest" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-full-name">نام و نام خانوادگی *</label>
                                <input id="marketing-full-name" name="FullName" value="@(marketing.FullName)" class="form-control sn-input" required />
                                @Html.ValidationMessage("FullName", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-mobile">شماره موبایل *</label>
                                <input id="marketing-mobile" name="Mobile" value="@(marketing.Mobile)" class="form-control sn-input" dir="ltr" inputmode="tel" placeholder="0912xxxxxxx" required />
                                @Html.ValidationMessage("Mobile", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-email">ایمیل</label>
                                <input id="marketing-email" name="Email" value="@(marketing.Email)" class="form-control sn-input" dir="ltr" type="email" />
                                @Html.ValidationMessage("Email", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-company">نام مجموعه یا برند</label>
                                <input id="marketing-company" name="CompanyName" value="@(marketing.CompanyName)" class="form-control sn-input" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-city">شهر یا محدوده فعالیت</label>
                                <input id="marketing-city" name="City" value="@(marketing.City)" class="form-control sn-input" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label" for="marketing-area">زمینه فعالیت و نوع ارتباطات *</label>
                                <input id="marketing-area" name="ActivityArea" value="@(marketing.ActivityArea)" class="form-control sn-input" placeholder="مثلاً فروش B2B، مشاوره کسب‌وکار، شبکه مدیران" required />
                                @Html.ValidationMessage("ActivityArea", null, new { @class = "text-danger small" })
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="marketing-experience">سابقه فروش و بازاریابی</label>
                                <input id="marketing-experience" name="SalesExperience" value="@(marketing.SalesExperience)" class="form-control sn-input" placeholder="سابقه، حوزه تخصصی یا نوع مشتریانی که با آن‌ها در ارتباط هستید" />
                            </div>
                            <div class="col-12">
                                <label class="form-label" for="marketing-message">توضیحات تکمیلی</label>
                                <textarea id="marketing-message" name="Message" class="form-control sn-input" rows="4" placeholder="هر نکته‌ای درباره مدل همکاری موردنظر یا فرصت‌های فروش احتمالی...">@marketing.Message</textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn sn-btn-primary btn-lg w-100"><i class="bi bi-send me-2"></i>ثبت درخواست همکاری</button>
                                <small class="text-muted d-block text-center mt-2">اطلاعات شما فقط برای بررسی درخواست همکاری استفاده می‌شود.</small>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>
}

@if (isIncoming && markerIndex >= 0)
{
    <section class="sn-section sn-incoming-after-form">
        <div class="@pageContainerClass">
            <article class="sn-article-body-content sn-incoming-content">
                @Html.Raw(bodyAfterForm)
            </article>
        </div>
    </section>
}
