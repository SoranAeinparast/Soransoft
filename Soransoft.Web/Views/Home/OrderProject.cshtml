@model Soransoft.Application.ViewModels.OrderProjectViewModel
@inject Soransoft.Application.Interfaces.ISiteSettingService Settings
@inject Soransoft.Application.Interfaces.ISiteService Site
@{
    ViewData["Title"] = "سفارش پروژه";
    var settings = await Settings.GetAllAsync();
    string S(string key, string def = "") => settings.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : def;
    var services = (await Site.GetServiceCardsAsync()).Where(service => !service.ComingSoon).ToList();
}
<section class="sn-page-hero">
    <div class="container text-center">
        <h1 class="sn-hero-title">@S("OrderHeroTitle", "سفــارش پروژه")</h1>
        <p class="sn-hero-text">@S("OrderHeroText", "فرم زیر را پر کنید تا کارشناسان ما در اسرع وقت با شما تماس بگیرند")</p>
    </div>
</section>

<section class="sn-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-7">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success text-center">@success</div>
                }
                <div class="sn-form-card">
                    <form asp-action="OrderProject" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control sn-input" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Mobile" class="form-label"></label>
                                <input asp-for="Mobile" class="form-control sn-input" dir="ltr" />
                                <span asp-validation-for="Mobile" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control sn-input" dir="ltr" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ProjectType" class="form-label"></label>
                            <select asp-for="ProjectType" class="form-select sn-input">
                                <option value="">انتخاب کنید…</option>
                                @foreach (var service in services)
                                {
                                    <option value="@((int)service.Kind)">@service.Title</option>
                                }
                            </select>
                            <span asp-validation-for="ProjectType" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Budget" class="form-label"></label>
                            <input asp-for="Budget" class="form-control sn-input" dir="ltr" />
                            <span asp-validation-for="Budget" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control sn-input" rows="5"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn sn-btn-primary btn-lg w-100">@S("OrderSubmitText", "ارسال سفارش")</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
