@model Soransoft.Web.Models.AboutUsViewModel
@inject Soransoft.Application.Interfaces.ISiteFeatureService Features
@{
    ViewData["Title"] = "درباره ما";
    string S(string key, string def = "") => Model.Settings.TryGetValue(key, out var v) && !string.IsNullOrWhiteSpace(v) ? v : def;
}
<section class="sn-page-hero">
    <div class="container text-center">
        <h1 class="sn-hero-title">@S("AboutHeroTitle", "دربــــــــاره مـــــــــا")</h1>
        <p class="sn-hero-text">@S("AboutHeroText", "ما کی هستیم؟ چی هستیم؟ چی کار می کنیم؟ اینجا کجاست؟! الان میگم!")</p>
    </div>
</section>

<section class="sn-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                <div class="sn-article-body-content">
                    <p>@S("AboutText")</p>
                    <p>@S("AboutParagraph1")</p>
                    <p>@S("AboutParagraph2")</p>
                </div>
            </div>
        </div>

        <h2 class="sn-section-title mt-5">@S("AboutTeamTitle", "یک تیم پر از سابقه")</h2>
        <div class="row g-4 justify-content-center">
            @foreach (var member in Model.Team)
            {
                <div class="col-12 col-md-4">
                    <div class="sn-team-card text-center">
                        <div class="sn-team-avatar">
                            @if (!string.IsNullOrWhiteSpace(member.Image))
                            {
                                <img src="@member.Image" alt="@member.FullName" loading="lazy" />
                            }
                            else
                            {
                                <i class="bi bi-person-circle"></i>
                            }
                        </div>
                        <h3>@member.FullName</h3>
                        <p class="text-muted">@member.Role</p>
                        @if (!string.IsNullOrWhiteSpace(member.LinkedinUrl))
                        {
                            <a href="@member.LinkedinUrl" target="_blank" rel="noopener" class="sn-social d-inline-flex"><i class="bi bi-linkedin"></i></a>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <p>@S("AboutCtaText", "اگر در هر زمینه‌ای به کمک تیم سوران سافت نیاز دارید فقط کافیه با ما تماس بگیرید")</p>
            @if (await Features.IsEnabledAsync(Soransoft.Application.Interfaces.SiteFeatures.Contact))
            {
                <a href="/ContactUs" class="btn sn-btn-primary px-5">@S("AboutCtaButton", "تماس با ما")</a>
            }
        </div>
    </div>
</section>
