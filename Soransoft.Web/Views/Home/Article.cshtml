@model Soransoft.Domain.Entities.Article
@{
    ViewData["Title"] = Model.Title;
}
<section class="sn-page-hero">
    <div class="container text-center">
        <span class="sn-badge">@Model.ArticleCategory.Title</span>
        <h1 class="sn-hero-title mt-3">@Model.Title</h1>
        <div class="sn-article-meta justify-content-center mt-3">
            <span><i class="bi bi-person me-1"></i>@Model.AuthorName</span>
            <span><i class="bi bi-calendar3 me-1"></i>@Model.PublishedAt.ToString("yyyy/MM/dd")</span>
            <span><i class="bi bi-eye me-1"></i>@Model.VisitCount بازدید</span>
        </div>
    </div>
</section>

<section class="sn-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8">
                @if (!string.IsNullOrWhiteSpace(Model.Image))
                {
                    <img src="@Model.Image" alt="@Model.Title" class="img-fluid rounded mb-4 w-100" />
                }
                <div class="sn-article-body-content">
                    @Html.Raw(Model.Body)
                </div>
                <div class="text-center mt-5">
                    <a href="/Articles" class="btn sn-btn-outline">همه مقالات</a>
                </div>
            </div>
        </div>
    </div>
</section>
