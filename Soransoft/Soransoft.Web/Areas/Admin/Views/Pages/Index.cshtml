@model List<SitePage>
@{
    ViewData["Title"] = "مدیریت صفحات";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">صفحات محتوایی</h5>
    <a href="/Admin/Pages/Create" class="btn sn-btn-primary"><i class="bi bi-plus-lg me-1"></i> صفحه جدید</a>
</div>

<div class="sn-admin-card">
    <div class="table-responsive">
        <table class="table sn-admin-table align-middle">
            <thead>
                <tr><th>#</th><th>عنوان</th><th>آدرس</th><th>وضعیت</th><th>ترتیب</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <strong>@item.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <small class="d-block text-muted">@item.Summary</small>
                            }
                        </td>
                        <td dir="ltr"><a href="/Page/@Uri.EscapeDataString(item.Slug)" target="_blank">/Page/@item.Slug</a></td>
                        <td><span class="badge @(item.IsPublished ? "bg-success" : "bg-secondary")">@(item.IsPublished ? "منتشر شده" : "پیش‌نویس")</span></td>
                        <td>@item.DisplayOrder</td>
                        <td class="text-nowrap">
                            <a href="/Admin/Pages/Edit/@item.Id" class="btn btn-sm btn-outline-primary">ویرایش</a>
                            <form method="post" action="/Admin/Pages/Delete/@item.Id" class="d-inline" data-swal-confirm="حذف شود؟">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
